# Postgres (Supabase: the pooled "transaction" connection string, port 6543).
DATABASE_URL=postgres://returns:returns@localhost:54329/returns

# The commercebuild storefront OIDC issuer the tokens come from — the value
# Store Admin shows for the identity bridge (no trailing slash).
CB_ISSUER=https://v5.dev.xmsymphony.com/v5-local

# Optional: fetch the keys from here instead of ${CB_ISSUER}/api/oidc/jwks
# (local development, when the issuer's public URL is not reachable).
# CB_JWKS_URL=http://localhost:3333/api/oidc/jwks

# This service's own origin: the `aud` of every token it accepts.
SERVICE_ORIGIN=http://localhost:4000

# The custom app's id, for links in emails back to its pages.
APP_ID=018e52f7-6072-4bc1-b64b-f9e8a0f06d70

# Merchant notification address for new returns.
ADMIN_NOTIFY_EMAIL=returns-admin@example.com

# Resend. Unset = emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Returns <onboarding@resend.dev>
